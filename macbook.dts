				reg = <0x800 0x00 0x00 0x00 0x00>;
				reset-gpios = <0x39 0x99 0x01>;
				#address-cells = <0x03>;
				#size-cells = <0x02>;
				ranges;
				interrupt-controller;
				#interrupt-cells = <0x01>;
				interrupt-map-mask = <0x00 0x00 0x00 0x07>;
				interrupt-map = <0x00 0x00 0x00 0x01 0xb5 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x02 0xb5 0x00 0x00 0x00 0x01 0x00 0x00 0x00 0x03 0xb5 0x00 0x00 0x00 0x02 0x00 0x00 0x00 0x04 0xb5 0x00 0x00 0x00 0x03>;
				status = "disabled";
				phandle = <0xb5>;
			};

			pci@2,0 {
				device_type = "pci";
				reg = <0x1000 0x00 0x00 0x00 0x00>;
				reset-gpios = <0x39 0x21 0x01>;
				#address-cells = <0x03>;
				#size-cells = <0x02>;
				ranges;
				interrupt-controller;
				#interrupt-cells = <0x01>;
				interrupt-map-mask = <0x00 0x00 0x00 0x07>;
				interrupt-map = <0x00 0x00 0x00 0x01 0xb6 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x02 0xb6 0x00 0x00 0x00 0x01 0x00 0x00 0x00 0x03 0xb6 0x00 0x00 0x00 0x02 0x00 0x00 0x00 0x04 0xb6 0x00 0x00 0x00 0x03>;
				status = "disabled";
				phandle = <0xb6>;
			};
		};
	};

	chosen {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		stdout-path = "serial0";

		framebuffer@0 {
			compatible = "apple,simple-framebuffer", "simple-framebuffer";
			reg = <0x00 0x00 0x00 0x00>;
			power-domains = <0x1a>;
			status = "disabled";
		};
	};

	memory@800000000 {
		device_type = "memory";
		reg = <0x08 0x00 0x02 0x00>;
	};

	led-controller {
		compatible = "pwm-leds";

		led-0 {
			pwms = <0xb7 0x00 0x9c40>;
			label = "kbd_backlight";
			function = "kbd_backlight";
			color = <0x00>;
			max-brightness = <0xff>;
			default-state = "keep";
		};
	};

	fixed-regulator-tas5770-sdz {
		compatible = "regulator-fixed";
		regulator-name = "tas5770-sdz";
		startup-delay-us = <0x1388>;
		gpios = <0x39 0xb5 0x00>;
		enable-active-high;
		phandle = <0x40>;
	};

	sound {
		compatible = "apple,j293-macaudio", "apple,macaudio";
		model = "MacBook Pro J293";

		dai-link@0 {
			link-name = "Speakers";

			cpu {
				sound-dai = <0xb8 0x00 0xb8 0x01>;
			};

			codec {
				sound-dai = <0xb9 0xba 0xbb 0xbc>;
			};
		};

		dai-link@1 {
			link-name = "Headphone Jack";

			cpu {
				sound-dai = <0xb8 0x02>;
			};

			codec {
				sound-dai = <0xbd>;
			};
		};
	};
};
