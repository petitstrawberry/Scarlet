			i2c0-pins {
				pinmux = <0x100c0 0x100bc>;
				phandle = <0x37>;
			};

			i2c1-pins {
				pinmux = <0x100c9 0x100c7>;
				phandle = <0x3e>;
			};

			i2c2-pins {
				pinmux = <0x100a3 0x100a2>;
				phandle = <0x41>;
			};

			i2c3-pins {
				pinmux = <0x10049 0x10048>;
				phandle = <0x44>;
			};

			i2c4-pins {
				pinmux = <0x10087 0x10086>;
				phandle = <0x46>;
			};

			spi1-pins {
				pinmux = <0x1002a 0x1002b 0x1002c 0x1002d>;
				phandle = <0x4b>;
			};

			spi3-pins {
				pinmux = <0x1002e 0x1002f 0x10030 0x10031>;
				phandle = <0x4e>;
			};

			pcie-pins {
				pinmux = <0x10096 0x10097 0x10020>;
				phandle = <0xb2>;
			};
		};

		spmi@23d0d9300 {
			compatible = "apple,t8103-spmi", "apple,spmi";
			reg = <0x02 0x3d0d9300 0x00 0x100>;
			#address-cells = <0x02>;
			#size-cells = <0x00>;

			pmu@f {
				compatible = "apple,sera-pmu", "apple,spmi-pmu";
				reg = <0x0f 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x01>;

				rtc_nvmem@d000 {
					compatible = "apple,spmi-pmu-nvmem";
					reg = <0xd000 0x300>;
					#address-cells = <0x01>;
					#size-cells = <0x01>;

					pm-setting@1 {
						reg = <0x01 0x01>;
						phandle = <0x81>;
					};

					rtc-offset@100 {
						reg = <0x100 0x06>;
						phandle = <0x7c>;
					};
				};

				legacy_nvmem@9f00 {
					compatible = "apple,spmi-pmu-nvmem";
					reg = <0x9f00 0x20>;
					#address-cells = <0x01>;
					#size-cells = <0x01>;

					boot-stage@1 {
						reg = <0x01 0x01>;
						phandle = <0x7e>;
					};

					boot-error-count@2 {
						reg = <0x02 0x01>;
						bits = <0x00 0x04>;
						phandle = <0x7f>;
					};

					panic-count@2 {
						reg = <0x02 0x01>;
						bits = <0x04 0x04>;
						phandle = <0x80>;
					};

					boot-error-stage@3 {
						reg = <0x03 0x01>;
					};

					shutdown-flag@f {
						reg = <0x0f 0x01>;
						bits = <0x03 0x01>;
						phandle = <0x7d>;
					};
				};

				scrpad_nvmem@a000 {
					compatible = "apple,spmi-pmu-nvmem";
					reg = <0xa000 0x1000>;
					#address-cells = <0x01>;
					#size-cells = <0x01>;

					fault-shadow@67b {
						reg = <0x67b 0x10>;
					};

					socd@b00 {
						reg = <0xb00 0x400>;
					};
				};
			};
		};

