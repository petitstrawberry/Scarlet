{
  "arch": "riscv32",
  "cpu": "generic-rv32",
  "crt-objects-fallback": "false",
  "data-layout": "e-m:e-p:32:32-i64:64-n32-S128",
  "eh-frame-header": false,
  "emit-debug-gdb-scripts": false,
  "features": "+m,+a,+zicsr,+zifencei",
  "linker": "rust-lld",
  "linker-flavor": "gnu-lld",
  "llvm-abiname": "ilp32",
  "llvm-target": "riscv32",
  "max-atomic-width": 32,
  "metadata": {
    "description": "Scarlet native RV32IMA user programs",
    "host_tools": false,
    "std": false,
    "tier": 3
  },
  "panic-strategy": "abort",
  "relocation-model": "static",
  "target-pointer-width": 32,
  "code-model": "medium",
  "os": "scarlet",
  "pre-link-args": {
    "ld.lld": [
      "-T",
      "../lds/user.ld",
      "--entry=_entry"
    ]
  }
}
