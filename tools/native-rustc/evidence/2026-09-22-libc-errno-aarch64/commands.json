{
  "image": [
    [
      "mkfs.ext2",
      "-F",
      "-b",
      "4096",
      "-L",
      "NATIVE_RUSTC",
      "-d",
      "/private/tmp/scarlet-errno-aarch64-final-v2/root-tree",
      "/private/tmp/scarlet-errno-aarch64-final-v2/root.ext2"
    ],
    [
      "cargo-scarlet-plugin-limine",
      "--arch",
      "aarch64",
      "--kernel",
      "/private/tmp/scarlet-native-fs-kernel-build/aarch64-unknown-none-elf/release/scarlet",
      "--initramfs",
      "/private/tmp/scarlet-errno-aarch64-final-v2/initramfs.cpio",
      "--output",
      "/private/tmp/scarlet-errno-aarch64-final-v2/boot.img",
      "--cache-dir",
      "/private/tmp/scarlet-errno-aarch64-final-v2/limine-cache",
      "--cmdline",
      "console=ttyAMA0 init=/init init.exec=/system/bin/native-rustc-probe init.console=/dev/tty0 root=/dev/vblk1 rootfstype=ext2 rootwait"
    ]
  ],
  "qemu": [
    "qemu-system-aarch64",
    "-machine",
    "virt,gic-version=3,acpi=off",
    "-cpu",
    "host",
    "-m",
    "4G",
    "-accel",
    "hvf",
    "-smp",
    "4",
    "-no-reboot",
    "-display",
    "none",
    "-monitor",
    "none",
    "-serial",
    "stdio",
    "-drive",
    "if=pflash,format=raw,unit=0,file=/nix/store/r8vnxn5j04g39a6jv7hawwwvr8frbxmx-qemu-11.0.91-scarlet/share/qemu/edk2-aarch64-code.fd,readonly=on",
    "-drive",
    "if=pflash,format=raw,unit=1,file=/private/tmp/scarlet-errno-aarch64-final-v2/efi-vars.fd",
    "-global",
    "virtio-mmio.force-legacy=false",
    "-drive",
    "id=boot,file=/private/tmp/scarlet-errno-aarch64-final-v2/boot.img,format=raw,if=none",
    "-device",
    "virtio-blk-device,drive=boot,bus=virtio-mmio-bus.0",
    "-drive",
    "id=root,file=/private/tmp/scarlet-errno-aarch64-final-v2/root.ext2,format=raw,if=none",
    "-device",
    "virtio-blk-device,drive=root,bus=virtio-mmio-bus.1",
    "-device",
    "virtio-gpu-device,bus=virtio-mmio-bus.3",
    "-object",
    "rng-random,id=compiler-entropy,filename=/dev/urandom",
    "-device",
    "virtio-rng-device,rng=compiler-entropy,bus=virtio-mmio-bus.6"
  ],
  "probe": [
    "/opt/scarlet/toolchains/rust/v0.1.0-rc.1/bin/rustc",
    "/opt/scarlet/toolchains/rust/v0.1.0-rc.1",
    "aarch64-unknown-scarlet",
    "/native-rustc-output",
    "--timeout",
    "900",
    "--run-timeout",
    "60",
    "--full",
    "--linker",
    "/opt/scarlet/toolchains/rust/v0.1.0-rc.1/bin/wild",
    "--linker-flavor",
    "ld.lld",
    "--proc-macro",
    "--native-fs",
    "--c-startup",
    "/system/bin/native-c-startup-probe"
  ]
}
