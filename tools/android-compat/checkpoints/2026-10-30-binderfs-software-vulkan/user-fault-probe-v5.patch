+pub(crate) fn probe_user_fault(message: alloc::string::String) {
+    for (_,device) in crate::device::manager::DeviceManager::get_manager().get_devices_with_ids() {
+        if device.as_any().is::<crate::drivers::uart::pl011::Pl011Uart>() {
+            if let Some(uart)=device.as_char_device() {let _=uart.write(message.as_bytes());let _=uart.write(b"\r\n");}
+        }
+    }
