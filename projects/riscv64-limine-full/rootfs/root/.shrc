#!/bin/sh
# Scarlet Shell Initialization Script

# Set environment variables
export LD_LIBRARY_PATH=/usr/lib:/lib
export PATH=/bin:/usr/bin:/systems/linux-riscv64/bin:/systems/linux-riscv64/sbin:/systems/linux-riscv64/usr/bin:/systems/linux-riscv64/usr/sbin

export XDG_RUNTIME_DIR=/tmp
export WAYLAND_DISPLAY=wayland-0
export GDK_BACKEND=wayland
export MESA_LOADER_DRIVER_OVERRIDE=swrast

export HOME=/root

echo "Welcome to Scarlet Shell!"
echo "PATH is set to: $PATH"
