#!/bin/sh
# Scarlet Shell Initialization Script

# Set environment variables
# export PATH=/scarlet/system/scarlet/bin:/scarlet/system/linux-riscv64/usr/bin
# export LD_LIBRARY_PATH=/scarlet/system/linux-riscv64/usr/lib:/scarlet/system/linux-riscv64/lib
export PATH=/scarlet/system/scarlet/bin:/scarlet/system/linux-aarch64/bin:/scarlet/system/linux-aarch64/usr/bin
export LD_LIBRARY_PATH=/scarlet/system/linux-aarch64/usr/lib:/scarlet/system/linux-aarch64/lib
export XDG_RUNTIME_DIR=/tmp
export WAYLAND_DISPLAY=wayland-0
export GDK_BACKEND=wayland
export MESA_LOADER_DRIVER_OVERRIDE=swrast

echo "Welcome to Scarlet Shell!"
echo "PATH is set to: $PATH"

# Other initializations can go here

echo "Shell initialized successfully"

# # Auto-start Linux guest via KVM (riscv64)
# /scarlet/system/linux-riscv64/usr/bin/lkvm run -k /scarlet/system/linux-riscv64/usr/bin/guest-Image -i /scarlet/system/linux-riscv64/usr/bin/guest-initramfs.cpio.gz -p "console=ttyS0 rdinit=/sbin/init" --console serial -n mode=none -m 512

# # Auto-start Linux guest via KVM (aarch64)
# /scarlet/system/linux-aarch64/usr/bin/lkvm run -k /scarlet/system/linux-aarch64/usr/bin/guest-Image -i /scarlet/system/linux-aarch64/usr/bin/guest-initramfs.cpio.gz -p "console=ttyS0 earlycon=uart,mmio,0x1000000 rdinit=/sbin/init" --console serial --irqchip=gicv3 -n mode=none -m 512
