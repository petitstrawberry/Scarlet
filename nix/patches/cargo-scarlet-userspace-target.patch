+    #[test]
+    fn userspace_target_defaults_preserve_existing_projects() {
+        for (kernel, expected) in [
+            ("riscv64gc-unknown-none-elf", "riscv64gc-unknown-scarlet"),
+            ("aarch64-unknown-none-elf", "aarch64-unknown-scarlet"),
+        ] {
+            let target = resolve_userspace_target(None, Path::new("/unused"), kernel).unwrap();
+            assert_eq!(target.argument, expected);
+            assert_eq!(target.artifact_directory, expected);
+        }
+        let config = ManifestUserspace {
+            target: "riscv32ima-unknown-none-elf".into(),
+        };
+        let target =
+            resolve_userspace_target(Some(&config), Path::new("/unused"), "aarch64").unwrap();
+        assert_eq!(target.argument, config.target);
+        assert_eq!(target.artifact_directory, config.target);
+    }
+
+    #[test]
+    fn userspace_json_target_is_project_relative_and_has_a_separate_artifact_name() {
+        let temp = std::env::temp_dir().join(format!(
+            "cargo-scarlet-userspace-target-{}",
+            std::process::id()
+        ));
+        fs::create_dir_all(temp.join("board")).unwrap();
+        fs::create_dir_all(temp.join("targets")).unwrap();
+        let spec = temp.join("targets/native-rv32.json");
+        fs::write(&spec, r#"{"arch":"riscv32","llvm-target":"riscv32"}"#).unwrap();
+        let config: ManifestUserspace =
+            toml::from_str("target = '../targets/native-rv32.json'").unwrap();
+        let target = resolve_userspace_target(
+            Some(&config),
+            &temp.join("board"),
+            "riscv32ima-unknown-none-elf",
+        )
+        .unwrap();
+        assert_eq!(
+            Path::new(&target.argument),
+            fs::canonicalize(&spec).unwrap()
+        );
+        assert_eq!(target.artifact_directory, "native-rv32");
+        let absolute = ManifestUserspace {
+            target: target.argument.clone(),
+        };
+        assert_eq!(
+            resolve_userspace_target(Some(&absolute), Path::new("/unused"), "unused").unwrap(),
+            target
+        );
+        #[cfg(unix)]
+        {
+            let alias = temp.join("board/alias.json");
+            std::os::unix::fs::symlink(&spec, &alias).unwrap();
+            let config = ManifestUserspace {
+                target: "alias.json".into(),
+            };
+            assert_eq!(
+                resolve_userspace_target(Some(&config), &temp.join("board"), "unused").unwrap(),
+                target
+            );
+        }
+        fs::remove_dir_all(temp).unwrap();
+    }
+
+    #[test]
+    fn userspace_target_rejects_missing_specs_and_invalid_configuration() {
+        for value in ["", "   ", "targets/not-json", "missing-target.json"] {
+            let config = ManifestUserspace {
+                target: value.into(),
+            };
+            assert!(
+                resolve_userspace_target(Some(&config), Path::new("/nonexistent"), "riscv32")
+                    .is_err()
+            );
+        }
+        assert!(toml::from_str::<ManifestUserspace>("target = 'x'\nextra = true").is_err());
+    }
