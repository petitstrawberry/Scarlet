@@ -187,0 +190,55 @@ struct ScarletManifest {
+/// Userspace may use a different OS ABI and target specification from the kernel.
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct ManifestUserspace {
+    /// Built-in triple or JSON path relative to scarlet.toml.
+    target: String,
+}
+
+#[derive(Debug, PartialEq, Eq)]
+struct CargoTarget {
+    argument: String,
+    artifact_directory: String,
+}
+
+fn resolve_userspace_target(
+    config: Option<&ManifestUserspace>,
+    project: &Path,
+    kernel_triple: &str,
+) -> Result<CargoTarget, String> {
+    let target = config
+        .map(|config| config.target.clone())
+        .unwrap_or_else(|| userspace_target_triple(kernel_triple));
+    if target.trim().is_empty() {
+        return Err("[userspace].target must not be empty".to_string());
+    }
+    let path = Path::new(&target);
+    let argument = if path
+        .extension()
+        .is_some_and(|extension| extension == "json")
+    {
+        let path = resolve_path(project, &target);
+        fs::canonicalize(&path)
+            .map_err(|error| {
+                format!(
+                    "cannot resolve userspace target {}: {error}",
+                    path.display()
+                )
+            })?
+            .display()
+            .to_string()
+    } else {
+        if path.components().count() != 1 || path.is_absolute() {
+            return Err("[userspace].target must be a triple or a JSON target path".to_string());
+        }
+        target.clone()
+    };
+    // Cargo names custom-target output directories after the actual argument's
+    // JSON file stem, not the absolute path or the JSON's llvm-target.
+    let artifact_directory = target_triple_from_build_target(&argument)?;
+    Ok(CargoTarget {
+        argument,
+        artifact_directory,
+    })
+}
