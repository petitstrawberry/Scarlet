From: Akihiko Odaki <odaki@rsg.ci.i.u-tokyo.ac.jp>
Subject: [PATCH] ui/cocoa: Make Retina backing pixels optional

Cocoa otherwise exposes a one-pixel-per-point surface and scales it on a
Retina display.  Add a Cocoa display option that sizes and reports the guest
display in backing pixels when requested.  The OpenGL path must also opt its
view into a high-resolution surface before creating the display context.

This ports upstream commit a3b23b946c85062ff6fbdcc3d1f10557715516e4 to the
QEMU 11 cocoa-virgl branch.  The filename is retained because flakes based on
a Git worktree exclude untracked replacement files.

diff --git a/qapi/ui.json b/qapi/ui.json
--- a/qapi/ui.json
+++ b/qapi/ui.json
@@ -1448,6 +1448,9 @@
 # @zoom-interpolation: Apply interpolation to smooth output when
 #     zoom-to-fit is enabled.  Defaults to "off".  (Since 9.0)
 #
+# @retina: Use host Retina backing pixels for Cocoa display sizing.
+#     Defaults to "off".
+#
 # Since: 7.0
 ##
 { 'struct': 'DisplayCocoa',
@@ -1456,5 +1459,6 @@
       '*full-grab': 'bool',
       '*swap-opt-cmd': 'bool',
       '*zoom-to-fit': 'bool',
-      '*zoom-interpolation': 'bool'
+      '*zoom-interpolation': 'bool',
+      '*retina': 'bool'
   } }

diff --git a/ui/cocoa.m b/ui/cocoa.m
--- a/ui/cocoa.m
+++ b/ui/cocoa.m
@@ -130,6 +130,7 @@ static QKbdState *kbd;
 static int cursor_hide = 1;
 static int left_command_key_enabled = 1;
 static bool swap_opt_cmd;
+static bool cocoa_retina;

 static CGInterpolationQuality zoom_interpolation = kCGInterpolationNone;
 static NSTextField *pauseLabel;
@@ -548,10 +549,13 @@
     [[self window] setContentAspectRatio:NSMakeSize(screen.width, screen.height)];

     if (!([[self window] styleMask] & NSWindowStyleMaskResizable)) {
-        CGFloat width = screen.width / [[self window] backingScaleFactor];
-        CGFloat height = screen.height / [[self window] backingScaleFactor];
+        NSSize contentSize = NSMakeSize(screen.width, screen.height);

-        [[self window] setContentSize:NSMakeSize(width, height)];
+        if (cocoa_retina) {
+            contentSize.width /= [[self window] backingScaleFactor];
+            contentSize.height /= [[self window] backingScaleFactor];
+        }
+        [[self window] setContentSize:contentSize];
         [[self window] center];
     } else if ([[self window] styleMask] & NSWindowStyleMaskFullScreen) {
         [[self window] setContentSize:[self fixAspectRatio:[self screenSafeAreaSize]]];
@@ -574,6 +579,7 @@
     /* Must be called with the BQL, i.e. via updateUIInfo */
     NSSize frameSize;
     QemuUIInfo info;
+    CGFloat backingScaleFactor = 1.0;

     if (!qemu_console_is_graphic(dcl.con)) {
         return;
@@ -582,6 +588,7 @@
     if ([self window]) {
         NSDictionary *description = [[[self window] screen] deviceDescription];
         CGDirectDisplayID display = [[description objectForKey:@"NSScreenNumber"] unsignedIntValue];
+        backingScaleFactor = [[self window] backingScaleFactor];
         NSSize screenSize = [[[self window] screen] frame].size;
         CGSize screenPhysicalSize = CGDisplayScreenSize(display);
         bool isFullscreen = ([[self window] styleMask] & NSWindowStyleMaskFullScreen) != 0;
@@ -609,8 +616,8 @@

     info.xoff = 0;
     info.yoff = 0;
-    info.width = frameSize.width * [[self window] backingScaleFactor];
-    info.height = frameSize.height * [[self window] backingScaleFactor];
+    info.width = frameSize.width * (cocoa_retina ? backingScaleFactor : 1.0);
+    info.height = frameSize.height * (cocoa_retina ? backingScaleFactor : 1.0);

     qemu_console_set_ui_info(dcl.con, &info, TRUE);
 }
@@ -2132,8 +2139,13 @@ static void cocoa_display_init(DisplayState *ds, DisplayOptions *opts)
     QemuCocoaAppController *controller = [[QemuCocoaAppController alloc] init];
     [NSApp setDelegate:controller];

+    if (opts->u.cocoa.has_retina) {
+        cocoa_retina = opts->u.cocoa.retina;
+    }
+
 #ifdef CONFIG_OPENGL
     if (display_opengl) {
+        [cocoaView setWantsBestResolutionOpenGLSurface:cocoa_retina];
         cocoa_gl = cocoa_gl_create(cocoaView, &dcl_gl_ops, &error_fatal);
         for (i = 0; (con = qemu_console_lookup_by_index(i)) != NULL; i++) {
             if (qemu_console_is_graphic(con)) {
